{
  "publisher": "rainbowatcher",
  "name": "yate",
  "displayName": "yate",
  "version": "1.0.0",
  "description": "Translate code comments and markdown files directly in VSCode",
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "engines": {
    "vscode": "^1.75.0"
  },
  "activationEvents": [
    "onCommand:yate.translate",
    "onCommand:yate.translateFile",
    "onCommand:yate.translateComments",
    "onCommand:yate.translateMarkdown"
  ],
  "contributes": {
    "commands": [
      {
        "command": "yate.translate",
        "title": "yate: Translate Selection"
      },
      {
        "command": "yate.translateFile",
        "title": "yate: Translate Entire File"
      },
      {
        "command": "yate.translateComments",
        "title": "yate: Translate Comments"
      },
      {
        "command": "yate.translateMarkdown",
        "title": "yate: Translate Markdown"
      }
    ],
    "configuration": {
      "title": "yate",
      "properties": {
        "yate.targetLanguage": {
          "type": "string",
          "default": "en",
          "enum": ["en", "zh-CN", "zh-TW", "ja", "ko", "es", "fr", "de", "ru", "pt", "it"],
          "description": "Target language for translation"
        },
        "yate.sourceLanguage": {
          "type": "string",
          "default": "auto",
          "description": "Source language (auto for automatic detection)"
        },
        "yate.apiKey": {
          "type": "string",
          "default": "",
          "description": "Translation API key (optional for some services)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./tsconfig.extension.json",
    "watch": "tsc -watch -p ./tsconfig.extension.json",
    "dev": "node scripts/dev.js",
    "lint": "eslint src/extension/**/*.ts",
    "lint:fix": "eslint src/extension/**/*.ts --fix"
  },
  "dependencies": {
    "@types/vscode": "^1.75.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^0.25.2",
    "@types/node": "^18.0.0",
    "typescript": "^4.7.4"
  }
}
